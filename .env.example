APP_NAME=BNMIT ODYSSEY API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DATABASE_URL=sqlite+aiosqlite:///./odyssey.db
DB_REQUIRE_SSL=false
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
# Optional comma-separated domains, e.g. bnmit.in,college.edu
ALLOWED_PED_EMAIL_DOMAINS=
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET_STUDENT_PHOTOS=student-photos
SUPABASE_BUCKET_BONAFIDES=bonafides
SUPABASE_BUCKET_FIXTURES=fixtures
SUPABASE_BUCKET_EVENT_MEDIA=event-media
SUPABASE_BUCKET_CERTIFICATE_TEMPLATES=certificate-templates
SUPABASE_BUCKET_CERTIFICATES=certificates
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=BNMIT ODYSSEY
BREVO_SANDBOX_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
TEST_MODE=true
RETURN_OTP_IN_RESPONSE=true
ALLOW_TEST_PAYMENT=true
INITIAL_ADMIN_EMAIL=admin@bnmit.in
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=BNMIT Odyssey Super Admin
